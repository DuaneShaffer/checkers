{
  "name": "checkers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "perft": "node trainer/perft-cli.ts",
    "bench": "node trainer/bench.ts",
    "train": "node trainer/train.ts",
    "train:resume": "node trainer/train.ts --resume",
    "train:smoke": "node trainer/train.ts --smoke",
    "export": "node trainer/export.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.186.1",
    "uqr": "^0.1.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
